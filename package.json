{
  "name": "glass-box-sampler",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "An interactive visualizer of LLM token sampling: streaming completions, live top-k distributions, temperature and top-p, entropy, and forking.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "fixtures": "tsx src/fixtures/build.ts",
    "harness": "node harness/run.mjs",
    "harness:selftest": "node harness/run.mjs --selftest"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "lighthouse": "13.4.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22.12"
  }
}
